# NOTE: Requires **VS2019 16.3** or later

# .Net Rules
# Description: These rules enforces consistent code quality guidelines.

root = true  # 所在目录是项目根目录，此目录及子目录下保存的文件都会生效    

[*]  # 对于所有文件
indent_style = space  # 缩进风格
tab_width = 4  # 缩进宽度
indent_size = 4 # 缩进宽度
charset = utf-8-bom  # 文件编码格式
end_of_line = lf  # 行尾格式，Windows一般为CRLF，Linux一般为LF，根据需要更改
insert_final_newline = true   #文件结尾添加换行符，以防警告
trim_trailing_whitespace = true

# Code files
[*.{cs,vb}]


dotnet_diagnostic.AD0001.severity = suggestion

