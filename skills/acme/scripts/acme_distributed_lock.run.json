{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ACME Distributed Lock",
      "type": "dotnet",
      "request": "launch",
      "program": "${workspaceFolder}/skills/acme/scripts/acme_distributed_lock.cs",
      "args": [
        "--settings",
        "${workspaceFolder}/skills/acme/scripts/acme_distributed_lock.settings.json"
      ],
      "cwd": "${workspaceFolder}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_WATCH_RESTART": "1"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "ACME Distributed Lock (Production)",
      "type": "dotnet",
      "request": "launch",
      "program": "${workspaceFolder}/skills/acme/scripts/acme_distributed_lock.cs",
      "args": [
        "--settings",
        "${workspaceFolder}/skills/acme/scripts/acme_distributed_lock.settings.json"
      ],
      "cwd": "${workspaceFolder}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "DOTNET_ENVIRONMENT": "Production"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
  ]
}