{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "ACME Certificate Monitor",
      "type": "dotnet",
      "request": "launch",
      "program": "${workspaceFolder}/skills/acme/acme_cert_monitor.cs",
      "args": [
        "--settings",
        "${workspaceFolder}/skills/acme/scripts/acme_cert_monitor.setting.json",
        "--certificates-path",
        "${workspaceFolder}/certificates"
      ],
      "cwd": "${workspaceFolder}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_WATCH_RESTART": "1"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal"
    },
    {
      "name": "ACME Certificate Monitor (Production)",
      "type": "dotnet",
      "request": "launch",
      "program": "${workspaceFolder}/skills/acme/acme_cert_monitor.cs",
      "args": [
        "--settings",
        "${workspaceFolder}/skills/acme/acme_cert_monitor.settings.json",
        "--certificates-path",
        "/app/certificates"
      ],
      "cwd": "${workspaceFolder}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "DOTNET_ENVIRONMENT": "Production"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal"
    }
  ]
}
