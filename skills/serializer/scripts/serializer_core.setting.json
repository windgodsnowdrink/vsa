{
  "version": "1.0",
  "compilationOptions": {
    "targetFramework": "net11.0",
    "langVersion": "preview",
    "nullable": "enable",
    "warnAsError": false,
    "optimize": true,
    "define": ["RELEASE"],
    "additionalArguments": ["--enable-preview-features"]
  },
  "publishOptions": {
    "publishAot": true,
    "trimMode": "partial",
    "selfContained": true,
    "publishSingleFile": true,
    "runtimeIdentifier": "win-x64",
    "outputPath": "../publish"
  },
  "dependencies": {
    "System.Text.Json": "8.0.0",
    "Newtonsoft.Json": "13.0.3",
    "YamlDotNet": "13.7.1",
    "protobuf-net": "3.2.30",
    "Microsoft.Extensions.Configuration": "8.0.0",
    "Microsoft.Extensions.DependencyInjection": "8.0.0",
    "Microsoft.Extensions.Logging": "8.0.0",
    "CommandLineParser": "2.9.1"
  },
  "frameworkReferences": [
    "Microsoft.NETCore.App"
  ],
  "copyToOutput": [
    {
      "include": "*.json",
      "exclude": "*.run.json"
    }
  ]
}
