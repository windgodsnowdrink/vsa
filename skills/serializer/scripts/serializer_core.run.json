{
  "version": "1.0",
  "profiles": [
    {
      "name": "JSON Serialize",
      "commandName": "Project",
      "commandLineArgs": "json serialize --input \"{\"name\": \"John\", \"age\": 30}\" --output output.json",
      "workingDirectory": "$(ProjectDir)",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "JSON Deserialize",
      "commandName": "Project",
      "commandLineArgs": "json deserialize --input output.json --type \"System.Collections.Generic.Dictionary`2[[System.String],[System.Object]]\"",
      "workingDirectory": "$(ProjectDir)",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      }
    },
    {
      "name": "XML Serialize",
