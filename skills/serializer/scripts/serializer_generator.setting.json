{
  "version": "1.0",
  "compilationOptions": {
    "targetFramework": "net10.0",
    "langVersion": "preview",
    "nullable": "enable",
    "warnAsError": false,
    "optimize": true,
    "define": ["RELEASE"],
    "additionalArguments": ["--enable-preview-features"]
  },
  "publishOptions": {
    "publishAot": true,
    "trimMode": "partial",
    "selfContained": true,
    "publishSingleFile": true,
    "runtimeIdentifier": "win-x64",
    "outputPath": "../publish"
  },
  "dependencies": {
    "System.Text.Json": "8.0.0",
    "CommandLineParser": "2.9.1"
  },
  "frameworkReferences": [
    "Microsoft.NETCore.App"
  ],
  "copyToOutput": [
    {
      "include": "*.json",
      "exclude": "*.run.json"
    }
  ]
}
