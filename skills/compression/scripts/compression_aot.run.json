{
  "name": "Compression AOT Runner",
  "description": "Compression AOT脚本运行配置",
  "version": "1.0.0",
  "runtime": {
    "framework": "net11.0",
    "aot": true,
    "invariantGlobalization": true,
    "publishReadyToRun": true
  },
  "execution": {
    "command": "dotnet run --project compression_aot.cs",
    "arguments": ["compress", "input.txt", "output.gz", "gzip", "optimal"],
    "workingDirectory": "./skills/compression/scripts",
    "timeout": 300000
  },
  "dependencies": {
    "packages": [
      {
        "name": "System.IO.Compression",
        "version": "10.0.0"
      },
      {
        "name": "System.IO.Compression.ZipFile",
        "version": "10.0.0"
      },
      {
        "name": "Microsoft.Extensions.DependencyInjection",
        "version": "10.0.0"
      },
      {
        "name": "Microsoft.Extensions.Logging",
        "version": "10.0.0"
      },
      {
        "name": "Microsoft.Extensions.Hosting",
        "version": "10.0.0"
      }
    ]
  },
  "logging": {
    "level": "Information",
    "providers": ["Console"]
  },
  "environmentVariables": {
    "DOTNET_ENVIRONMENT": "Production",
    "DOTNET_PUBLISH_AOT": "1",
    "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "1"
  }
}