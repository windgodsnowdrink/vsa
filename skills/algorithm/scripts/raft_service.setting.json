{
  "RaftServiceSettings": {
    "NodeId": "raft-node-1",
    "ClusterNodes": ["raft-node-1", "raft-node-2", "raft-node-3"],
    "ElectionTimeout": "00:00:00.500",
    "HeartbeatInterval": "00:00:00.150",
    "LogDirectory": "./raft-logs",
    "MaxLogEntries": 10000,
    "SnapshotInterval": "00:30:00",
    "EnableMetrics": true,
    "EnableDebugLogging": false,
    "PerformanceOptimization": {
      "EnableSpanOptimization": true,
      "EnableMemoryPooling": true,
      "EnableCacheLineAlignment": true,
      "EnableParallelProcessing": true,
      "MaxConcurrentAppends": 5,
      "MaxConcurrentReads": 10,
      "EnableMemoryMappedFiles": true,
      "BufferSize": 65536
    },
    "NetworkSettings": {
      "EnableMessageCompression": true,
      "EnableBatchProcessing": true,
      "BatchSize": 10,
      "BatchInterval": "00:00:00.050",
      "EnableTls": false,
      "ConnectionTimeout": "00:00:05.000"
    },
    "LogSettings": {
      "EnableWriteAheadLogging": true,
      "EnableLogCompression": true,
      "LogFlushInterval": "00:00:01.000",
      "MaxLogFileSizeMB": 100
    },
    "LeaderElection": {
      "EnablePreVote": true,
      "EnableLeaderStickiness": true,
      "StickyTimeout": "00:05:00"
    },
    "MetricsSettings": {
      "CollectionInterval": "00:00:10.000",
      "EnablePrometheusExporter": false,
      "PrometheusPort": 9090
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Algorithm.Raft": "Debug",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}