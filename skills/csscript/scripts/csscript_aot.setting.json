{
  "Csscript": {
    "EnableCache": true,
    "CacheSize": 1000,
    "Timeout": "00:00:30",
    "EnableDetailedLogging": false,
    "WorkerCount": 4,
    "RetryCount": 3,
    "RetryInterval": "00:00:00.5",
    "ScriptExecutionTimeout": "00:01:00",
    "AllowExternalScripts": false,
    "ScriptCacheDirectory": "./script_cache"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Csscript.AOT": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "Performance": {
    "EnableMetrics": true,
    "MetricsInterval": "00:00:10",
    "EnableTracing": false
  },
  "Security": {
    "EnableAuthentication": false,
    "EnableAuthorization": false,
    "AllowedOrigins": ["*"]
  }
}