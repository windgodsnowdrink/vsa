{
  "version": "1.0.0",
  "runtime": {
    "framework": "net11.0",
    "sdk": "10.0.0",
    "runtimeIdentifiers": [
      "win-x64",
      "linux-x64",
      "osx-x64",
      "win-arm64",
      "linux-arm64",
      "osx-arm64"
    ]
  },
  "environment": {
    "development": {
      "ASPNETCORE_ENVIRONMENT": "Development",
      "DOTNET_ENVIRONMENT": "Development",
      "DOTNET_LOG_LEVEL": "Information",
      "ENABLE_DYNAMIC_CODE_GENERATION": "true",
      "ENABLE_CODE_CACHE": "true",
      "CODE_CACHE_SIZE": "100",
      "ENABLE_AOT_COMPATIBLE_MODE": "true",
      "MAX_CONCURRENT_COMPILATIONS": "5",
      "COMPILATION_TIMEOUT_MS": "10000",
      "ENABLE_PERFORMANCE_METRICS": "true"
    },
    "production": {
      "ASPNETCORE_ENVIRONMENT": "Production",
      "DOTNET_ENVIRONMENT": "Production",
      "DOTNET_LOG_LEVEL": "Warning",
      "ENABLE_DYNAMIC_CODE_GENERATION": "true",
      "ENABLE_CODE_CACHE": "true",
      "CODE_CACHE_SIZE": "200",
      "ENABLE_AOT_COMPATIBLE_MODE": "true",
      "MAX_CONCURRENT_COMPILATIONS": "10",
      "COMPILATION_TIMEOUT_MS": "20000",
      "ENABLE_PERFORMANCE_METRICS": "true"
    }
  },
  "deployment": {
    "aot": {
      "enabled": true,
      "publishProfiles": {
        "win-x64": {
          "command": "dotnet publish -c Release -r win-x64 --self-contained true -p:PublishAot=true",
          "outputDirectory": "bin/Release/net11.0/win-x64/publish"
        },
        "linux-x64": {
          "command": "dotnet publish -c Release -r linux-x64 --self-contained true -p:PublishAot=true",
          "outputDirectory": "bin/Release/net11.0/linux-x64/publish"
        },
        "osx-x64": {
          "command": "dotnet publish -c Release -r osx-x64 --self-contained true -p:PublishAot=true",
          "outputDirectory": "bin/Release/net11.0/osx-x64/publish"
        }
      }
    },
    "container": {
      "dockerfile": "Dockerfile",
      "context": ".",
      "buildArgs": {
        "SDK_VERSION": "10.0",
        "RUNTIME_VERSION": "10.0"
      },
      "tags": [
        "natasha-integration:latest",
        "natasha-integration:{version}"
      ]
    }
  },
  "performance": {
    "optimizations": {
      "codeCaching": true,
      "parallelCompilation": true,
      "memoryPooling": true,
      "lazyInitialization": true
    },
    "limits": {
      "maxConcurrentCompilations": 5,
      "maxCompilationTime": "10s",
      "maxGeneratedTypes": 1000,
      "codeCacheSize": 100
    }
  },
  "security": {
    "sandbox": {
      "enabled": true,
      "restrictedDirectories": [
        "../",
        "/etc/",
        "/sys/",
        "/proc/"
      ],
      "allowedDirectories": [
        "./temp/",
        "./logs/"
      ]
    },
    "permissions": {
      "allowFileAccess": true,
      "allowNetworkAccess": false,
      "allowReflection": true,
      "allowDynamicCode": true
    }
  },
  "logging": {
    "providers": [
      "Console",
      "Debug",
      "EventLog"
    ],
    "logLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "Plugin.Natasha": "Debug"
    },
    "fileLogging": {
      "enabled": true,
      "path": "logs/natasha-integration.log",
      "maxFileSize": "10MB",
      "maxRetainedFiles": 5
    }
  },
  "monitoring": {
    "healthChecks": {
      "enabled": true,
      "endpoint": "/health",
      "interval": "30s"
    },
    "metrics": {
      "enabled": true,
      "endpoint": "/metrics",
      "collectionInterval": "10s",
      "counters": [
        "compilationCount",
        "compilationTime",
        "cacheHits",
        "cacheMisses"
      ]
    },
    "tracing": {
      "enabled": true,
      "samplingRate": 0.1,
      "exporters": [
        "Jaeger",
        "Zipkin"
      ]
    }
  }
}
