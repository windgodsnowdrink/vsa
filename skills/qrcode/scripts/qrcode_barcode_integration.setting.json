{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "QrCodeIntegration": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5006",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      }
    },
    "QrCodeIntegration-Production": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "launchBrowser": false,
      "applicationUrl": "http://localhost:5006",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production"
      }
    }
  },
  "buildOptions": {
    "targetFramework": "net10.0",
    "langVersion": "preview",
    "nullable": true,
    "implicitUsings": true,
    "publishAot": true,
    "readyToRun": true,
    "tieredCompilation": true,
    "trimMode": "partial",
    "optimize": true
  },
  "dependencies": {
    "Microsoft.Extensions.DependencyInjection": "10.0.0",
    "Microsoft.Extensions.Logging": "10.0.0",
    "Microsoft.Extensions.Options": "10.0.0",
    "ZXing.Net": "0.16.12",
    "SkiaSharp": "2.88.6",
    "System.Drawing.Common": "8.0.0"
  },
  "runtimeOptions": {
    "tfm": "net10.0",
    "framework": {
      "name": "Microsoft.NETCore.App",
      "version": "10.0.0"
    }
  },
  "publishOptions": {
    "include": [
      "**/*.dll",
      "**/*.json",
      "**/*.config"
    ],
    "exclude": [
      "**/*.pdb",
      "**/*.xml"
    ]
  },
  "compilationOptions": {
    "allowUnsafe": true,
    "deterministic": true,
    "strict": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "QrCodeIntegration": "Debug"
    }
  },
  "AllowedHosts": "*",
  "QrCodeService": {
    "EnableCaching": true,
    "CacheSize": 100,
    "DefaultErrorCorrectionLevel": "Medium",
    "DefaultQRCodeSize": 256,
    "EnableAsyncProcessing": true,
    "MaxConcurrentOperations": 10,
    "EnableDetailedLogging": false,
    "CacheExpirationMinutes": 30
  },
  "Performance": {
    "EnableMemoryPooling": true,
    "MaxPoolSize": 100,
    "EnableThreadLocalStorage": true,
    "MaxDegreeOfParallelism": 4
  },
  "Security": {
    "EnableInputValidation": true,
    "MaxContentLength": 10485760, // 10MB
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/gif",
      "image/bmp"
    ]
  }
}
