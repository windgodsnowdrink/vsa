{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "QrCodeIntegration - Development",
      "type": "dotnet",
      "request": "launch",
      "program": "${workspaceFolder}/skills/qrcode/scripts/qrcode_barcode_integration.cs",
      "args": [
        "--settings",
        "${workspaceFolder}/skills/qrcode/scripts/qrcode_barcode_integration.setting.json",
        "--environment",
        "Development"
      ],
      "cwd": "${workspaceFolder}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_ENVIRONMENT": "Development",
        "DOTNET_RUNNING_IN_CONTAINER": "false",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
        "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "false"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "launchBrowser": false
    },
    {
      "name": "QrCodeIntegration - Production",
      "type": "dotnet",
      "request": "launch",
      "program": "${workspaceFolder}/skills/qrcode/scripts/qrcode_barcode_integration.cs",
      "args": [
        "--settings",
        "${workspaceFolder}/skills/qrcode/scripts/qrcode_barcode_integration.setting.json",
        "--environment",
        "Production"
      ],
      "cwd": "${workspaceFolder}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "DOTNET_ENVIRONMENT": "Production",
        "DOTNET_RUNNING_IN_CONTAINER": "false",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
        "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "false",
        "DOTNET_TieredPGO": "1",
        "DOTNET_ReadyToRun": "1"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "launchBrowser": false
    },
    {
      "name": "QrCodeIntegration - AOT Debug",
      "type": "dotnet",
      "request": "launch",
      "program": "${workspaceFolder}/skills/qrcode/scripts/bin/Release/net10.0/win-x64/publish/qrcode_barcode_integration.exe",
      "args": [
        "--settings",
        "${workspaceFolder}/skills/qrcode/scripts/qrcode_barcode_integration.setting.json",
        "--environment",
        "Production"
      ],
      "cwd": "${workspaceFolder}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "DOTNET_ENVIRONMENT": "Production",
        "DOTNET_RUNNING_IN_CONTAINER": "false",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
        "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "false",
        "DOTNET_TieredPGO": "1",
        "DOTNET_ReadyToRun": "1",
        "DOTNET_PublishAot": "1"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "launchBrowser": false
    },
    {
      "name": "QrCodeIntegration - AOT Publish",
      "type": "dotnet",
      "request": "launch",
      "program": "dotnet",
      "args": [
        "publish",
        "${workspaceFolder}/skills/qrcode/scripts/qrcode_barcode_integration.cs",
        "-c",
        "Release",
        "-r",
        "win-x64",
        "--self-contained",
        "true",
        "/p:PublishAot=true",
        "/p:TrimMode=partial",
        "/p:ReadyToRun=true",
        "/p:TieredPGO=true",
        "/p:Optimize=true",
        "/p:TargetFramework=net10.0"
      ],
      "cwd": "${workspaceFolder}",
      "environmentVariables": {
        "ASPNETCORE_ENVIRONMENT": "Production",
        "DOTNET_ENVIRONMENT": "Production",
        "DOTNET_CLI_TELEMETRY_OPTOUT": "1"
      },
      "stopAtEntry": false,
      "console": "integratedTerminal",
      "internalConsoleOptions": "openOnSessionStart",
      "launchBrowser": false
    }
  ],
  "compounds": [
    {
      "name": "QrCodeIntegration - All Configurations",
      "configurations": [
        "QrCodeIntegration - Development",
        "QrCodeIntegration - Production"
      ]
    }
  ],
  "runtimeOptions": {
    "tfm": "net10.0",
    "framework": {
      "name": "Microsoft.NETCore.App",
      "version": "10.0.0"
    },
    "configProperties": {
      "System.GC.Server": true,
      "System.Threading.ThreadPool.MinThreads": 4,
      "System.Threading.ThreadPool.MaxThreads": 32,
      "System.Net.SocketsHttpHandler.Http2FlowControl": true,
      "System.Text.Json.Serialization.Metadata.TrimmedRootTypeResolver": true
    }
  },
  "performanceOptions": {
    "enableMemoryProfiling": false,
    "enableCpuProfiling": false,
    "enableI/OProfiling": false,
    "enableGcLogging": false,
    "enableEventTracing": false
  }
}

