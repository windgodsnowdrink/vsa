{
  "name": "CsvHelper AOT",
  "description": "CsvHelper AOT高性能CSV处理脚本",
  "version": "1.0.0",
  "dependencies": [
    "Microsoft.Extensions.DependencyInjection@10.0.0",
    "Microsoft.Extensions.Logging@10.0.0",
    "Microsoft.Extensions.Hosting@10.0.0",
    "Microsoft.Extensions.Options@10.0.0",
    "Newtonsoft.Json@13.0.3",
    "CsvHelper@32.0.1",
    "CsvHelper.Schema@32.0.1"
  ],
  "environmentVariables": {
    "ASPNETCORE_ENVIRONMENT": "Production",
    "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
    "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "1",
    "CSVHELPER_DEFAULT_DELIMITER": ",",
    "CSVHELPER_HAS_HEADER_RECORD": "true",
    "CSVHELPER_IGNORE_BLANK_LINES": "true",
    "CSVHELPER_ENABLE_CACHE": "true",
    "CSVHELPER_CACHE_SIZE": "1000"
  },
  "execution": {
    "command": "dotnet run --project csvhelper_aot.cs",
    "workingDirectory": "./scripts",
    "timeout": "300000",
    "retryCount": 3
  },
  "aotCompilation": {
    "enabled": true,
    "publishAot": true,
    "invariantGlobalization": true,
    "enableCompilationRelaxations": true,
    "publishReadyToRun": true
  },
  "logging": {
    "enabled": true,
    "level": "Information",
    "file": "csvhelper_aot.log",
    "maxFileSize": "10MB",
    "maxRetainedFiles": 5
  },
  "monitoring": {
    "enabled": true,
    "metrics": [
      "executionTime",
      "memoryUsage",
      "cpuUsage",
      "successRate",
      "processedFiles",
      "processedRecords",
      "cacheHitRate"
    ],
    "alertThresholds": {
      "executionTime": "10000",
      "memoryUsage": "200MB",
      "cpuUsage": "80",
      "processedFiles": "1000"
    }
  }
}