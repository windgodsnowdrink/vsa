{
  "runtime": {
    "environmentVariables": {
      "DOTNET_ENVIRONMENT": "Development",
      "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
      "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "false",
      "UI_TYPE": "Web",
      "UI_THEME": "Light",
      "UI_CULTURE": "en-US",
      "UI_PERFORMANCE_MONITORING": "true",
      "UI_ACCESSIBILITY_CHECKS": "true",
      "WEB_PORT": "8080",
      "WEB_HOST": "localhost",
      "WEB_USE_HTTPS": "true",
      "LOG_LEVEL": "Information"
    },
    "commandLineArgs": [
      "--ui-type", "web",
      "--theme", "light",
      "--culture", "en-US",
      "--log-level", "information"
    ],
    "workingDirectory": "../bin/Release/net10.0/win-x64/publish",
    "applicationName": "ui_core",
    "processName": "ui_core.exe",
    "exitCodes": {
      "success": 0,
      "error": 1,
      "usageError": 2
    }
  },
  "profiles": {
    "WebDevelopment": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "UI_TYPE": "Web",
        "WEB_PORT": "8080",
        "WEB_HOST": "localhost",
        "WEB_USE_HTTPS": "false"
      },
      "commandLineArgs": [
        "--ui-type", "web",
        "--theme", "light",
        "--culture", "en-US",
        "--log-level", "Debug"
      ]
    },
    "WebProduction": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Production",
        "UI_TYPE": "Web",
        "WEB_PORT": "80",
        "WEB_HOST": "0.0.0.0",
        "WEB_USE_HTTPS": "true"
      },
      "commandLineArgs": [
        "--ui-type", "web",
        "--theme", "system",
        "--culture", "en-US",
        "--log-level", "Warning"
      ]
    },
    "DesktopDevelopment": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "UI_TYPE": "Desktop"
      },
      "commandLineArgs": [
        "--ui-type", "desktop",
        "--theme", "light",
        "--culture", "en-US",
        "--log-level", "Debug"
      ]
    },
    "DesktopProduction": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Production",
        "UI_TYPE": "Desktop"
      },
      "commandLineArgs": [
        "--ui-type", "desktop",
        "--theme", "system",
        "--culture", "en-US",
        "--log-level", "Warning"
      ]
    },
    "MobileDevelopment": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "UI_TYPE": "Mobile"
      },
      "commandLineArgs": [
        "--ui-type", "mobile",
        "--theme", "light",
        "--culture", "en-US",
        "--log-level", "Debug"
      ]
    },
    "MobileProduction": {
      "commandName": "Project",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Production",
        "UI_TYPE": "Mobile"
      },
      "commandLineArgs": [
        "--ui-type", "mobile",
        "--theme", "system",
        "--culture", "en-US",
        "--log-level", "Warning"
      ]
    },
    "AotPublish": {
      "commandName": "Publish",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Production"
      },
      "publishProfile": "Default",
      "commandLineArgs": []
    }
  },
  "debug": {
    "enableLogging": true,
    "logFile": "ui_core.log",
    "logLevel": "Debug",
    "enableDiagnostics": true,
    "diagnosticsPort": 0,
    "waitForDebugger": false,
    "launchBrowser": true,
    "browserUrl": "http://localhost:8080"
  },
  "performance": {
    "gcServer": true,
    "gcConcurrent": true,
    "gcRetainVM": true,
    "threadPoolMinThreads": 4,
    "threadPoolMaxThreads": 32,
    "maxDegreeOfParallelism": 4,
    "enableTailLatencyOptimization": true,
    "enableTieredCompilation": true,
    "enableDynamicProfileGuidedOptimization": true
  },
  "security": {
    "enableHTTPS": true,
    "certificatePath": "",
    "certificatePassword": "",
    "enableCORS": true,
    "allowedOrigins": [
      "http://localhost:3000",
      "http://localhost:8080",
      "https://localhost:7001"
    ],
    "enableContentSecurityPolicy": true,
    "contentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"
  },
  "scaling": {
    "enableHorizontalScaling": false,
    "maxInstances": 1,
    "minInstances": 1,
    "cpuThreshold": 70,
    "memoryThreshold": 80
  },
  "healthChecks": {
    "enabled": true,
    "endpoint": "/health",
    "timeout": "30s",
    "interval": "30s",
    "retries": 3
  },
  "deployment": {
    "type": "SelfContained",
    "targetRuntime": "win-x64",
    "publishSingleFile": true,
    "publishTrimmed": true,
    "publishAot": true,
    "includeNativeLibrariesForSelfExtract": true,
    "copyOutputToOutputDirectory": true,
    "outputType": "Exe"
  }
}
