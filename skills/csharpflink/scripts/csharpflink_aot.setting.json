{
  "CsharpFlink": {
    "EnableCache": true,
    "CacheSize": 1000,
    "Timeout": "00:00:30",
    "EnableDetailedLogging": false,
    "WorkerCount": 4,
    "RetryCount": 3,
    "RetryInterval": "00:00:00.5",
    "Parallelism": 4,
    "CheckpointInterval": "00:00:10",
    "StateRetentionTime": "24:00:00"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "CsharpFlink.AOT": "Information",
      "Microsoft": "Warning",
      "System": "Warning"
    }
  },
  "Performance": {
    "EnableMetrics": true,
    "MetricsInterval": "00:00:10",
    "EnableTracing": false
  },
  "Security": {
    "EnableAuthentication": false,
    "EnableAuthorization": false,
    "AllowedOrigins": ["*"]
  }
}