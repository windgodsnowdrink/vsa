{
  "$schema": "http://json.schemastore.org/launchsettings.json",
  "profiles": {
    "FastReportAotEngine": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "applicationUrl": "http://localhost:5002"
    },
    "FastReportAotEngine_Production": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Production"
      },
      "applicationUrl": "http://localhost:8002"
    },
    "FastReportAotEngine_Version": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "args": ["version"]
    },
    "FastReportAotEngine_CreateReport": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "args": ["create", "SalesReport"]
    },
    "FastReportAotEngine_LoadReport": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "args": ["load", "templates/SalesReport.frx"]
    },
    "FastReportAotEngine_RunReport": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "args": ["run", "templates/SalesReport.frx"]
    },
    "FastReportAotEngine_ExportReport": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "args": ["export", "templates/SalesReport.frx", "output/SalesReport.pdf", "PDF"]
    },
    "FastReportAotEngine_PreviewReport": {
      "commandName": "Project",
      "dotnetRunMessages": true,
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development"
      },
      "args": ["preview", "templates/SalesReport.frx"]
    }
  }
}