{
  "environments": {
    "development": {
      "command": "dotnet run --project ocr_extensions.cs",
      "workingDirectory": "d:\\Trae\\vsa\\skills\\ocr\\scripts",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Development",
        "ASPNETCORE_ENVIRONMENT": "Development",
        "DOTNET_PUBLISH_AOT": "1",
        "DOTNET_TieredCompilation": "1",
        "DOTNET_ReadyToRun": "1",
        "LOG_LEVEL": "Debug"
      },
      "timeout": "30000"
    },
    "production": {
      "command": "dotnet publish --configuration Release --output ./publish",
      "workingDirectory": "d:\\Trae\\vsa\\skills\\ocr\\scripts",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Production",
        "ASPNETCORE_ENVIRONMENT": "Production",
        "DOTNET_PUBLISH_AOT": "1",
        "DOTNET_TieredCompilation": "1",
        "DOTNET_ReadyToRun": "1",
        "LOG_LEVEL": "Information"
      },
      "timeout": "60000"
    },
    "performance": {
      "command": "dotnet run --project ocr_extensions.cs --performance",
      "workingDirectory": "d:\\Trae\\vsa\\skills\\ocr\\scripts",
      "environmentVariables": {
        "DOTNET_ENVIRONMENT": "Performance",
        "DOTNET_PUBLISH_AOT": "1",
        "DOTNET_TieredCompilation": "1",
        "DOTNET_ReadyToRun": "1",
        "LOG_LEVEL": "Error",
        "PERFORMANCE_TEST_ITERATIONS": "100",
        "PERFORMANCE_TEST_BATCH_SIZE": "10"
      },
      "timeout": "120000"
    }
  },
  "publish": {
    "runtimes": [
      "win-x64",
      "linux-x64",
      "osx-x64"
    ],
    "options": {
      "selfContained": true,
      "publishSingleFile": true,
      "publishReadyToRun": true,
      "publishAot": true,
      "tieredCompilation": true
    },
    "output": {
      "win-x64": "publish\\win-x64",
      "linux-x64": "publish\\linux-x64",
      "osx-x64": "publish\\osx-x64"
    }
  },
  "test": {
    "command": "dotnet test",
    "workingDirectory": "d:\\Trae\\vsa\\skills\\ocr\\scripts",
    "environmentVariables": {
      "DOTNET_ENVIRONMENT": "Test",
      "LOG_LEVEL": "Warning"
    },
    "timeout": "60000"
  }
}