{
  "name": "liquidstate_aot",
  "version": "1.0.0",
  "description": "基于AOT编译的状态机工具",
  "author": "NET专家",
  "commands": [
    {
      "name": "create",
      "alias": "c",
      "description": "创建状态机",
      "arguments": [
        {
          "name": "name",
          "type": "string",
          "description": "状态机名称"
        }
      ],
      "options": []
    },
    {
      "name": "start",
      "alias": "s",
      "description": "启动状态机",
      "arguments": [
        {
          "name": "name",
          "type": "string",
          "description": "状态机名称"
        },
        {
          "name": "initialState",
          "type": "string",
          "description": "初始状态"
        }
      ],
      "options": []
    },
    {
      "name": "fire",
      "alias": "f",
      "description": "触发状态机事件",
      "arguments": [
        {
          "name": "name",
          "type": "string",
          "description": "状态机名称"
        },
        {
          "name": "event",
          "type": "string",
          "description": "事件"
        }
      ],
      "options": []
    },
    {
      "name": "stop",
      "alias": "st",
      "description": "停止状态机",
      "arguments": [
        {
          "name": "name",
          "type": "string",
          "description": "状态机名称"
        }
      ],
      "options": []
    },
    {
      "name": "list",
      "alias": "l",
      "description": "列出所有状态机",
      "arguments": [],
      "options": []
    },
    {
      "name": "remove",
      "alias": "r",
      "description": "移除状态机",
      "arguments": [
        {
          "name": "name",
          "type": "string",
          "description": "状态机名称"
        }
      ],
      "options": []
    },
    {
      "name": "help",
      "alias": "h",
      "description": "显示帮助信息",
      "arguments": [],
      "options": []
    }
  ],
  "dependencies": [
    {
      "name": "Microsoft.Extensions.DependencyInjection",
      "version": "10.0.0"
    },
    {
      "name": "Microsoft.Extensions.Caching.Memory",
      "version": "10.0.0"
    },
    {
      "name": "Microsoft.Extensions.Logging",
      "version": "10.0.0"
    },
    {
      "name": "Microsoft.Extensions.Options",
      "version": "10.0.0"
    },
    {
      "name": "System.CommandLine",
      "version": "2.0.0"
    },
    {
      "name": "System.Threading.Channels",
      "version": "8.0.0"
    }
  ],
  "build": {
    "targetFramework": "net11.0",
    "outputType": "Exe",
    "publishSingleFile": true,
    "selfContained": true,
    "runtimeIdentifier": "win-x64",
    "optimize": true,
    "publishTrimmed": true,
    "publishAot": true,
    "includeNativeLibrariesForSelfExtract": true,
    "enableCppCodeGen": true,
    "langVersion": "preview"
  },
  "runtime": {
    "workingDirectory": "d:\\Trae\\vsa",
    "environmentVariables": {
      "DOTNET_SYSTEM_GLOBALIZATION_INVARIANT": "false",
      "DOTNET_RUNNING_IN_CONTAINER": "false"
    },
    "timeout": 30000,
    "memoryLimit": 1024
  },
  "validation": {
    "enabled": true,
    "strict": false
  }
}