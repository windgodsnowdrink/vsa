      "arguments": [],
      "environmentVariables": {}
    },
    "cutforsearch": {
      "command": "cutforsearch",
      "description": "搜索引擎模式分词",
      "arguments": [],
      "environmentVariables": {}
    },
    "extract": {
      "command": "extract",
      "description": "提取关键词",
      "arguments": [],
      "environmentVariables": {}
    },
    "pos": {
      "command": "pos",
      "description": "词性标注",
      "arguments": [],
      "environmentVariables": {}
    },
    "batch": {
      "command": "batch",
      "description": "批量处理文本文件",
      "arguments": [],
