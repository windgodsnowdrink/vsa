<Project>
    <!-- See https://aka.ms/dotnet/msbuild/customize for more details on customizing your build -->
    <PropertyGroup Label="Build">
        <CodeAnalysisRuleSet>$(MSBuildThisFileDirectory)dotnet.ruleset</CodeAnalysisRuleSet>
        <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <DocumentationFile>$(OutputPath)$(AssemblyName).xml</DocumentationFile>
        <NoDefaultExcludes>true</NoDefaultExcludes>
        <LangVersion>preview</LangVersion>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <AnalysisLevel>latest</AnalysisLevel>
        <AnalysisMode>All</AnalysisMode>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <TargetFramework>net11.0</TargetFramework>
        <SonarQubeProject>cleanrobot</SonarQubeProject>
        <SonarQubeOrganization>wgsd</SonarQubeOrganization>
        <SonarQubeHostUrl>http://127.0.0.1:9000</SonarQubeHostUrl>
        <SonarQubeToken>sqp_9a2a23df3a917a691a844a641787048bb3415303</SonarQubeToken>
        <ContainerImageTags>0.0.1-rc;latest</ContainerImageTags>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
        <NoWarn>$(NoWarn);CS1998;CS1591</NoWarn>
        <WarningsAsErrors>$(WarningsAsErrors);CS0114;CS8785;RZ10012</WarningsAsErrors>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <Version>1.0.0.10</Version>
        <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
        <NeutralLanguage>zh-CN</NeutralLanguage>
        <InvariantGlobalization>true</InvariantGlobalization>
        <Configuration Condition="'$(Configuration)'==''">Debug</Configuration>
        <Configurations>Debug;Release;DebugBlazorServer;</Configurations>
        <Environment Condition="'$(Environment)' == '' AND '$(Configuration)' == 'Release'">Production</Environment>
        <Environment Condition="'$(Environment)' == '' AND  $(Configuration.Contains('Debug'))">Development</Environment>
        <Environment Condition="'$(Environment)' == '' AND  $(Configuration.Contains('Staging'))">Staging</Environment>
        <Environment Condition="'$(Environment)' == '' AND  $(Configuration.Contains('Production'))">Production</Environment>
        <DefineConstants Condition="$(TargetFramework.Contains('-android'))">$(DefineConstants);Android</DefineConstants>
        <DefineConstants Condition="$(TargetFramework.Contains('-ios'))">$(DefineConstants);iOS</DefineConstants>
        <DefineConstants Condition="$(TargetFramework.Contains('-windows'))">$(DefineConstants);Windows</DefineConstants>
        <DefineConstants Condition="$(TargetFramework.Contains('-mac'))">$(DefineConstants);Mac</DefineConstants>
        <DefineConstants Condition="'$(InvariantGlobalization)' == 'true'">$(DefineConstants);InvariantGlobalization</DefineConstants>
        <DefineConstants>$(DefineConstants);$(Environment);$(Configuration)</DefineConstants>
        <DefineConstants Condition="$(Configuration.Contains('Debug'))">$(DefineConstants);DEBUG</DefineConstants>
        <HotReloadAutoRestart>true</HotReloadAutoRestart>
        <CompressionEnabled Condition="'$(Environment)' == 'Development'">false</CompressionEnabled>
        <ArtifactsPath>$(MSBuildThisFileDirectory)artifacts</ArtifactsPath>
        <UseArtifactsOutput>true</UseArtifactsOutput>
        <CompilerGeneratedFilesOutputPath>$(BaseIntermediateOutputPath)Generated</CompilerGeneratedFilesOutputPath>
        <RollForward>LatestPatch</RollForward>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
        <InvariantGlobalization>False</InvariantGlobalization>
        <MicrosoftExtensionsVersion>10.0.5</MicrosoftExtensionsVersion>
        <AspireVersion>13.2.0</AspireVersion>
        <IsAspireHost>false</IsAspireHost>
        <MicrosoftExtensionsAiVersion>10.4.1</MicrosoftExtensionsAiVersion>
        <MicrosoftExtensionsAiEvaluationVersion>10.4.0</MicrosoftExtensionsAiEvaluationVersion>
        <CommunityToolkitVersion>8.4.1</CommunityToolkitVersion>
        <DaprVersion>1.17.5</DaprVersion>
        <ApplicationInsightsVersion>3.0.0</ApplicationInsightsVersion>
        <CodeAnalysisVersion>5.3.0</CodeAnalysisVersion>
        <SkiaSharpVersion>3.119.2</SkiaSharpVersion>
        <MassTransitVersion>8.5.10</MassTransitVersion>
        <AspNetCoreVersion>10.0.5</AspNetCoreVersion>
        <ComponentsVersion>10.0.5</ComponentsVersion>
        <OpenTelemetryVersion>1.15.0</OpenTelemetryVersion>
        <WolverineFxVersion>5.22.0</WolverineFxVersion>
        <PollyVersion>8.7.0</PollyVersion>
        <EasyCachingVersion>1.9.2</EasyCachingVersion>
        <NSwagVersion>14.6.3</NSwagVersion>
        <SwashbuckleVersion>10.1.5</SwashbuckleVersion>
        <NacosVersion>1.3.10</NacosVersion>
        <GrpcVersion>2.76.0</GrpcVersion>
        <OpenIddictVersion>7.4.0</OpenIddictVersion>
        <QuartzVersion>3.16.1</QuartzVersion>
    </PropertyGroup>
</Project>
