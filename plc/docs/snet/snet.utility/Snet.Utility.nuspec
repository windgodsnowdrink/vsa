<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Snet.Utility</id>
    <version>26.235.1</version>
    <authors>Shun</authors>
    <requireLicenseAcceptance>true</requireLicenseAcceptance>
    <license type="expression">MIT</license>
    <licenseUrl>https://licenses.nuget.org/MIT</licenseUrl>
    <icon>icon.png</icon>
    <readme>README.md</readme>
    <projectUrl>https://snet.cn/</projectUrl>
    <description>核心组件：Utility（字节、枚举、文件、字符串、验证、比对、转换、反射、Json、Xml、Protobuf、Ftp、System ...）</description>
    <repository type="git" commit="6bec27efc0f2c65dc751ab34757e37960f2b43fe" />
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
        <dependency id="protobuf-net" version="3.4.14" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Newtonsoft.Json" version="13.0.4" exclude="Build,Analyzers" />
        <dependency id="protobuf-net" version="3.4.14" exclude="Build,Analyzers" />
      </group>
    </dependencies>
  </metadata>
</package>