        <dependency id="Snet.Core" version="26.235.2" exclude="Build,Analyzers" />
      </group>
      <group targetFramework="net8.0">
        <dependency id="Dapper" version="2.1.79" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Data.SqlClient" version="7.0.2" exclude="Build,Analyzers" />
        <dependency id="Microsoft.Data.Sqlite" version="10.0.11" exclude="Build,Analyzers" />
