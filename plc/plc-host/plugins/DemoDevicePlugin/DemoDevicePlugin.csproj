<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DemoDevicePlugin</RootNamespace>
    <AssemblyName>DemoDevicePlugin</AssemblyName>
    <!-- 插件输出到宿主可发现的 plugins/<Name>/bin/... 路径下 -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Private=false：契约层不随插件复制，由宿主 ALC 以共享程序集方式解析，保证类型身份一致 -->
    <ProjectReference Include="..\..\Plc.Plugins.Contracts\Plc.Plugins.Contracts.csproj">
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

</Project>
