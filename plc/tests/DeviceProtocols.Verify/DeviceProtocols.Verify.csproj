<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeviceProtocols.Verify</RootNamespace>
    <AssemblyName>DeviceProtocols.Verify</AssemblyName>
    <IsPackable>false</IsPackable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Plc.Plugins.Contracts\Plc.Plugins.Contracts.csproj" />
    <ProjectReference Include="..\..\src\plc-host\plugins\MelsecDevicePlugin\MelsecDevicePlugin.csproj" />
    <ProjectReference Include="..\..\src\plc-host\plugins\BacnetDevicePlugin\BacnetDevicePlugin.csproj" />
    <ProjectReference Include="..\..\src\plc-host\plugins\FatekDevicePlugin\FatekDevicePlugin.csproj" />
    <ProjectReference Include="..\..\src\plc-host\plugins\KeyenceDevicePlugin\KeyenceDevicePlugin.csproj" />
    <ProjectReference Include="..\..\src\plc-host\plugins\FujiDevicePlugin\FujiDevicePlugin.csproj" />
    <ProjectReference Include="..\..\src\plc-host\plugins\LoRaDevicePlugin\LoRaDevicePlugin.csproj" />
  </ItemGroup>

  <!-- *Test.cs 使用 #load "AI.cs" 等脚本指令加载 File-based 应用源（位于
       src/PlcAiot.Stability/file-based/）。#load 仅在 .csx 脚本中合法，
       嵌入常规 csproj 会触发 CS8097；File-based 应用源亦非可被常规 MSBuild
       项目直接 Compile 的库源。这些 *Test.cs 是探索性 smoke test，
       真正的设备协议帧往返验证入口在 Program.cs。将其从 Compile 移除。 -->
  <ItemGroup>
    <Compile Remove="*Test.cs" />
  </ItemGroup>

  <!-- .NET 11 预览版下 Microsoft.NET.Sdk 会在 CoreCompile 前重置程序集特性开关，
       导致与手动 AssemblyInfo.cs 重复（CS0579）。在此强制锁定，确保 SDK 不再生成默认特性。 -->
  <Target Name="LockAssemblyInfoFlags" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
      <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    </PropertyGroup>
  </Target>

</Project>
