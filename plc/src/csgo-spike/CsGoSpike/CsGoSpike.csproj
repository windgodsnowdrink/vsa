<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Must match the library's windows TFM (WinForms is referenced by CsGo). -->
    <TargetFramework>net11.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>CsGoSpike</RootNamespace>
    <AssemblyName>CsGoSpike</AssemblyName>
    <!-- 允许在非 Windows 主机（CI/Linux）上交叉编译 net*-windows 目标 -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CsGo-master\CsGo\CsGo.csproj" />
  </ItemGroup>

</Project>
