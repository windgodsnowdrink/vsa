<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>FormTest</AssemblyName>
    <RootNamespace>FormTest</RootNamespace>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="FormTest.cs" />
    <Compile Include="FormTest.Designer.cs" DependentUpon="FormTest.cs" />
    <Compile Include="WaitForm.cs" />
    <Compile Include="WaitForm.Designer.cs" DependentUpon="WaitForm.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="FormTest.resx" DependentUpon="FormTest.cs" />
    <EmbeddedResource Include="WaitForm.resx" DependentUpon="WaitForm.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CsGo\CsGo.csproj" />
  </ItemGroup>

</Project>
