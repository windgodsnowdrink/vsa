<!--
  plc-saas.csproj — PLC·AIOT 多租户 SaaS 后端（File-based App 的可构建/可发布工程）
  目的：让 `dotnet build` / `dotnet publish` / `dotnet run` 直接可用（此前仅能 `dotnet run Program.cs` 文件模式）。
  实现：复用 File-based 源，经 strip-app.ps1 剥离 #include/#r 后编译（Program.cs 作入口）。
  包引用与 plc-saas.verify 对齐（去掉 xunit/测试 SDK）。
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1591;AD0001;CS0169;CS0168;CS0419;NU1701</NoWarn>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <!--
    File-based 源（entities/infra/seed/Program + slices）含 #include / #r 指令，
    不能直接由常规 MSBuild 编译。改为：全部源由 strip-app 剥离指令后落到
    obj/.../stripped，仅编译 stripped 产物（与 plc-saas.verify 的 PrepareStrippedSources 对齐）。
    注意：不要在此处再 <Compile Include> 原始 *.cs，否则会与 stripped 产物重复定义。
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    EF Core 系版本必须与 Npgsql.EF 提供程序对齐（勿单独升级）：
    Npgsql.EntityFrameworkCore.PostgreSQL 11.0.0-preview.6 对 Microsoft.EntityFrameworkCore.Relational
    是精确版本钉死（= preview.6），EF Core / Identity.EF / JwtBearer 一旦升到 preview.7，
    恢复图出现「精确版本 vs 最低版本」冲突 → NU1107 硬错误，构建直接失败（2026-10-13 实测）。
    要升级 EF 必须等 Npgsql 提供程序发布对应预览版后三件套整体对齐。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="11.0.0-preview.6" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="sql/rls.sql" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="docker-compose.yml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="initdb/01-roles.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- Phase 3 SaaS 控制台 SPA：原样复制到输出目录，由 UseStaticFiles/MapFallbackToFile 托管 -->
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- File-based 源 → 剥离 #include/#r → 编译（Program.cs 作入口） -->
  <Target Name="PrepareStrippedApp" BeforeTargets="CoreCompile">
    <RemoveDir Directories="$(IntermediateOutputPath)stripped" Condition="Exists('$(IntermediateOutputPath)stripped')" />
    <Exec Condition="'$(OS)' == 'Windows_NT'"
          Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)strip-app.ps1&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\stripped&quot;" />
    <Exec Condition="'$(OS)' != 'Windows_NT'"
          Command="bash &quot;$(MSBuildThisFileDirectory)strip-app.sh&quot; &quot;$(MSBuildProjectDirectory)&quot; &quot;$(MSBuildProjectDirectory)/obj/$(Configuration)/$(TargetFramework)/stripped&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)stripped\**\*.cs" />
    </ItemGroup>
  </Target>

</Project>
