<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>PlcAiot.Desktop</RootNamespace>
    <AssemblyName>PlcAiot.Desktop</AssemblyName>
    <!-- 允许在非 Windows 主机（CI/Linux）上交叉编译 net*-windows 目标（WPF 引用程序集可解析） -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PlcAiot.Shared\PlcAiot.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.0.0-preview.3.25208.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <Target Name="CopyPages" BeforeTargets="BeforeBuild">
    <ItemGroup>
      <PageFiles Include="..\..\pages\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(PageFiles)" DestinationFolder="wwwroot\pages\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>
