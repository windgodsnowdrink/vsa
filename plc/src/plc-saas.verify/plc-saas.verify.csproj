<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1591;AD0001;CS0169</NoWarn>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- .NET 11 SDK 起 dotnet test 默认 VSTest 已移除；xunit.v3 基于 Microsoft.Testing.Platform，
         须显式启用新测试体验（否则报 TestingPlatform MTP 错误）。 -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    EF Core 系版本必须与 Npgsql.EF 提供程序对齐（勿单独升级）：Npgsql.EF preview.6 对
    EF Relational 是精确版本钉死，EF 三件套升 preview.7 会触发 NU1107 硬错误（2026-10-13 实测）。
    与 plc-saas.csproj 保持同一版本。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="ModelContextProtocol" Version="2.2.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.2.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="11.0.0-preview.6.26359.118" />
    <PackageReference Include="Qdrant.Client" Version="1.19.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.22.0" />
    <PackageReference Include="Mediator.Abstractions" Version="3.0.2" />
    <PackageReference Include="Mediator.SourceGenerator" Version="3.0.2">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="MQTTnet" Version="5.2.0.1603" />
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <!-- 注意：xunit.v3 基于 Microsoft.Testing.Platform（MTP）。.NET 11 SDK 已移除 VSTest，
         故不得再引用 xunit.runner.visualstudio（VSTest 适配器），否则 dotnet test 走已删除的
         VSTest 目标而报错。Microsoft.NET.Test.Sdk 即 MTP 宿主，dotnet test 自动走 MTP。 -->
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
  </ItemGroup>

  <!-- 源快照：供 ADR-108 红线静态校验测试读取（仅复制为内容，不参与编译；排除 verify 自身文件） -->
  <ItemGroup>
    <_SaasSrc Include="$(MSBuildThisFileDirectory)../plc-saas/*.cs">
      <Link>saas-src/%(Filename)%(Extension)</Link>
    </_SaasSrc>
    <_SaasSrc Include="$(MSBuildThisFileDirectory)../plc-saas/slices/*.cs">
      <Link>saas-src/slices/%(Filename)%(Extension)</Link>
    </_SaasSrc>
    <Content Include="@(_SaasSrc)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!--
      注意：不要再加回 ProjectReference 到 plc-saas。本工程已通过 PrepareStrippedSources
      本地编译同一批切片源（= plc-saas 完整源码，ADR-101 的工程化 typecheck 语义不变）。
      若同时引用 plc-saas.dll，同一批请求类型会以「源 + 元数据」双份进入本编译
      （CS0436 ×1024），Mediator 源生成器进而为每个请求生成两份 Wrapper_For_*，
      ContainerMetadata 重复定义 → CS0102 硬错误（2026-10-13 实测，SDK 11.0.100-preview.7）。
    -->
    <Compile Include="VerifyTests.cs" />
  </ItemGroup>

  <!-- File-based 源 → 剥离 #include/#r → 编译（ADR-101 的工程化 typecheck） -->
  <Target Name="PrepareStrippedSources" BeforeTargets="CoreCompile">
    <RemoveDir Directories="$(IntermediateOutputPath)stripped" Condition="Exists('$(IntermediateOutputPath)stripped')" />
    <Exec Condition="'$(OS)' == 'Windows_NT'" Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)strip-sources.ps1&quot; &quot;$(MSBuildThisFileDirectory)../plc-saas&quot; &quot;$(IntermediateOutputPath)stripped&quot;" />
    <Exec Condition="'$(OS)' != 'Windows_NT'" Command="bash &quot;$(MSBuildThisFileDirectory)strip-sources.sh&quot; &quot;$(MSBuildThisFileDirectory)../plc-saas&quot; &quot;$(IntermediateOutputPath)stripped&quot;" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)stripped\**\*.cs" />
    </ItemGroup>
  </Target>

</Project>
