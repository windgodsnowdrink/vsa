<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <RootNamespace>Plc.Host</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 关闭 SDK 自动生成的程序集特性：.NET 11 预览版 Microsoft.NET.Sdk.Web 与 Dapr.AspNetCore
         的 build target 会重复生成 AssemblyInfo / TargetFramework 特性，导致 CS0579。
         改用手动 Properties/AssemblyInfo.cs 单一来源。 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <!-- 排除子目录源码被宿主默认编译（否则与 ProjectReference 同名类型冲突 / 重复 AssemblyInfo） -->
    <Compile Remove="Plc.Plugins.Contracts\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <!-- 插件源码由各自工程独立编译并经 ALC 运行时加载，禁止宿主重复编译 -->
    <Compile Remove="plugins\**\*.cs" />
    <None Remove="Plc.Plugins.Contracts\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugins\BacnetDevicePlugin\BacnetDevicePlugin.csproj" />
    <None Include="plugins\DemoDevicePlugin\DemoDevicePlugin.csproj" />
    <None Include="plugins\FatekDevicePlugin\FatekDevicePlugin.csproj" />
    <None Include="plugins\FujiDevicePlugin\FujiDevicePlugin.csproj" />
    <None Include="plugins\KeyenceDevicePlugin\KeyenceDevicePlugin.csproj" />
    <None Include="plugins\LoRaDevicePlugin\LoRaDevicePlugin.csproj" />
    <None Include="plugins\MelsecDevicePlugin\MelsecDevicePlugin.csproj" />
  </ItemGroup>

  <!-- Tier1 设备协议插件：作为构建依赖触发各自编译，但不进宿主依赖图 / 默认 ALC。
       ReferenceOutputAssembly=false → 宿主编译不静态引用插件程序集；
       Private=false → 不自动复制插件 DLL（改由下方 CopyPluginAssemblies 显式复制）。
       注：这些 ProjectReference 仅用于驱动插件工程构建 + 建立构建顺序，运行时仍由 PluginManager 经 ALC 加载各自产物。 -->
  <ItemGroup>
    <ProjectReference Include="plugins\BacnetDevicePlugin\BacnetDevicePlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="plugins\DemoDevicePlugin\DemoDevicePlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="plugins\FatekDevicePlugin\FatekDevicePlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="plugins\FujiDevicePlugin\FujiDevicePlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="plugins\KeyenceDevicePlugin\KeyenceDevicePlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="plugins\LoRaDevicePlugin\LoRaDevicePlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="plugins\MelsecDevicePlugin\MelsecDevicePlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- 前端 cockpit / devices 静态页面（源自 PlcAiot.Web/wwwroot/pages），同源托管到输出 wwwroot/pages -->
  <ItemGroup>
    <Content Include="..\PlcAiot.Web\wwwroot\pages\**">
      <Link>wwwroot\pages\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- 根 SPA（wwwroot/index.html + app.js + pages/*）同源托管到 /console/，浏览器以相对路径调用 /api/gateway/* 与 /api/devices/*，
       与 cockpit/devices 同源方案对齐；置于 /console/ 子目录避免覆盖已验证的 /pages/ 成品。 -->
  <ItemGroup>
    <Content Include="..\..\wwwroot\**">
      <Link>wwwroot\console\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <!-- 反编译 SNET 生产 DLL 参考源码已迁出 plugins/ 命名空间：规范全量语料见 docs/snet/decompiled/
       （plugins/Snet.* 曾为与其逐字节重复的副本，已于 2026-09-02 去壳删除）。
       其不再作为宿主工程内容；新增协议插件请置于 plugins/<Name>/ 并实现 IPlugin + IDeviceProtocol（详见 plugins/README.md）。 -->

  <ItemGroup>
    <PackageReference Include="Carter" Version="10.0.0" />
    <PackageReference Include="StreamJsonRpc" Version="2.25.29" />
    <PackageReference Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />
    <PackageReference Include="OpenTelemetry" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageReference Include="Polly" Version="8.7.0" />
    <PackageReference Include="ScottPlot" Version="5.1.59" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
    <PackageReference Include="CommunityToolkit.Diagnostics" Version="8.4.2" />
    <PackageReference Include="Foundatio" Version="13.0.2" />
    <PackageReference Include="Dapr.AspNetCore" Version="1.18.5" />
    <PackageReference Include="Dapr.Client" Version="1.18.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Plc.Plugins.Contracts\Plc.Plugins.Contracts.csproj" />
  </ItemGroup>

  <!-- 把各插件工程的产物 DLL 显式复制到运行时 plugins/<Name>/bin/ 下，供 PluginManager 扫描发现。
       插件工程自带的 CopyPluginToHost 目标只复制到源码树 plugins/<Name>/bin/，此处完成「源码树 → 输出目录」的搬运。 -->
  <Target Name="CopyPluginAssemblies" AfterTargets="Build">
    <ItemGroup>
      <_PluginDll Include="plugins\*\bin\*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_PluginDll)"
          DestinationFiles="@(_PluginDll->'$(OutDir)plugins\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
