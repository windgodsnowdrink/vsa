<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputType>Exe</OutputType>
    <RootNamespace>Plc.Host</RootNamespace>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- 关闭 SDK 自动生成的程序集特性：.NET 11 预览版 Microsoft.NET.Sdk.Web 与 Dapr.AspNetCore
         的 build target 会重复生成 AssemblyInfo / TargetFramework 特性，导致 CS0579。
         改用手动 Properties/AssemblyInfo.cs 单一来源。 -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <ItemGroup>
    <!-- 排除子目录源码被宿主默认编译（否则与 ProjectReference 同名类型冲突 / 重复 AssemblyInfo） -->
    <Compile Remove="Plc.Plugins.Contracts\**\*.cs" />
    <Compile Remove="tests\**\*.cs" />
    <!-- 插件源码由各自工程独立编译并经 ALC 运行时加载，禁止宿主重复编译 -->
    <Compile Remove="plugins\**\*.cs" />
    <None Remove="Plc.Plugins.Contracts\**" />
    <None Remove="tests\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="plugins\BacnetDevicePlugin\BacnetDevicePlugin.csproj" />
    <None Include="plugins\DemoDevicePlugin\DemoDevicePlugin.csproj" />
    <None Include="plugins\FatekDevicePlugin\FatekDevicePlugin.csproj" />
    <None Include="plugins\FujiDevicePlugin\FujiDevicePlugin.csproj" />
    <None Include="plugins\KeyenceDevicePlugin\KeyenceDevicePlugin.csproj" />
    <None Include="plugins\LoRaDevicePlugin\LoRaDevicePlugin.csproj" />
    <None Include="plugins\MelsecDevicePlugin\MelsecDevicePlugin.csproj" />
  </ItemGroup>

  <!-- 前端 cockpit / devices 静态页面（源自 PlcAiot.Web/wwwroot/pages），同源托管到输出 wwwroot/pages -->
  <ItemGroup>
    <Content Include="..\PlcAiot.Web\wwwroot\pages\**">
      <Link>wwwroot\pages\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
