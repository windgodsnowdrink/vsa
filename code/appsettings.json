{
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning"
        }
    },
    "AllowedHosts": "*",
    "ConnectionStrings": {
        "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=TodoDb;Trusted_Connection=True;MultipleActiveResultSets=true"
    },
    "Kestrel": {
        "Endpoints": {
            "Http": {
                "Url": "http://localhost:5000"
            },
            "Https": {
                "Url": "https://localhost:5001"
            },
            "WebSocket": {
                "Url": "ws://localhost:5002"
            },
            "WebSocketSecure": {
                "Url": "wss://localhost:5003"
            },
            "Grpc": {
                "Url": "http://localhost:5004"
            },
            "GrpcSecure": {
                "Url": "URL_ADDRESS:5005"
            }
        }
    },
    "Jwt": {
        "Key": "your_secret_key",
        "Issuer": "your_issuer",
        "Audience": "your_audience"
    },
    "Swagger": {
        "Title": "Todo API",
        "Version": "v1"
    },
    "Keycloak": {
        "ServerUrl": "https://keycloak.example.com/auth",
        "Realm": "your-realm",
        "ClientId": "your-client-id",
        "ClientSecret": "your-client-secret",
        "TokenEndpoint": "/protocol/openid-connect/token",
        "UserInfoEndpoint": "/protocol/openid-connect/userinfo",
        "CacheDuration": "00:05:00"
    },
    "Mvc": {
        "CompatibilityVersion": "Version_3_0"
    },
    "HttpsRedirection": {
        "Enabled": true,
        "RedirectStatusCode": 301
    },
    "StaticFiles": {
        "Enabled": true,
        "RequestPath": "/static"
    },
    "ResponseCompression": {
        "Enabled": true,
        "Providers": "Gzip"
    },
    "HttpsPolicy": {
        "HttpsPort": 443,
        "HttpPort": 80,
        "RedirectStatusCode": 301
    },
    "Hsts": {
        "IncludeSubDomains": true,
        "MaxAge": 31536000
    },
    "XssProtection": {
        "Enabled": true,
        "BlockMode": "Block"
    },
    "ContentTypeOptions": {
        "Enabled": true
    },
    "ReferrerPolicy": {
        "Enabled": true,
        "Policy": "SameOrigin"
    },
    "CacheControl": {
        "Enabled": true,
        "MaxAge": 31536000
    },
    "FeaturePolicy": {
        "Enabled": true,
        "Policies": {
            "Camera": "self",
            "Microphone": "self",
            "Geolocation": "self"
        }
    },
    "Csp": {
        "Enabled": true,
        "Policies": {
            "DefaultSrc": "'self'",
            "ScriptSrc": "'self'",
            "StyleSrc": "'self'",
            "ImgSrc": "'self'",
            "FontSrc": "'self'",
            "ConnectSrc": "'self'",
            "FrameSrc": "'self'",
            "MediaSrc": "'self'",
            "ObjectSrc": "'none'",
            "BaseUri": "'none'",
            "FormAction": "'self'",
            "FrameAncestors": "'none'",
            "PluginTypes": "'none'",
            "Sandbox": "allow-forms allow-same-origin allow-scripts",
            "ReportUri": "/csp-report"
        }
    },
    "NoSniff": {
        "Enabled": true
    },
    "IframeOptions": {
        "Enabled": true,
        "AllowFrom": "'none'"
    },
    "NoOpen": {
        "Enabled": true
    },
    "Xfo": {
        "Enabled": true,
        "Policy": "deny"
    },
    "XpFrameOptions": {
        "Enabled": true,
        "Policy": "deny"
    },
    "XContentTypeOptions": {
        "Enabled": true
    },
    "XDownloadOptions": {
        "Enabled": true
    },
    "XPermittedCrossDomainPolicies": {
        "Enabled": true,
        "Policy": "none"
    },
    "XXssProtection": {
        "Enabled": true,
        "BlockMode": "Block"
    },
